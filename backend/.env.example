# ==============================================================================
# SmartCache & LLM Router Environment Variables
# ==============================================================================

# 1. Google Gemini API (for LLM generation and Text-Embedding-004)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Pinecone Vector Database (for semantic vector similarity search)
# Get key from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=smartcache

# 3. Upstash Redis (for ultra-fast response caching and real-time stats)
# Get credentials from: https://console.upstash.com/
# Option A: REST API (Recommended - Works everywhere over HTTPS)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Option B: Standard Redis TLS URL (Alternative)
# REDIS_URL=rediss://default:xxxx@xxxx.upstash.io:6379

# 4. Gateway Tuning
SIMILARITY_THRESHOLD=0.90
CACHE_TTL_SECONDS=86400
CORS_ORIGINS=http://localhost:5173
